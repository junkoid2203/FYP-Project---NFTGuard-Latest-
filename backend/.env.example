# ---------------------------------------------------------------------------
# NFTGuard - environment configuration
#
# TO RUN THIS PROJECT:  copy this file to ".env" in the same folder, then
#                       npm install && npm start
#
# It is pre-filled to work without installing anything else. The database
# points at a hosted MongoDB Atlas cluster, so MongoDB does NOT need to be
# installed locally, and the marketplace data is already there.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# OPTION A - hosted cluster (nothing to install, needs internet)
# The full demonstration dataset (54 NFTs, 250 transactions, 44 fraud flags)
# already lives there. The connection string is given in APPENDIX B of the
# project report; it is not committed here because this repository is public.
# Paste it below, replacing this line, and skip Option B entirely.
# MONGODB_URI=mongodb+srv://<see Appendix B of the report>

# OPTION B - local MongoDB (no credential needed)
# Install MongoDB Community Server, leave the line below as it is, then run
# "npm run seed" once to create the demonstration data.
MONGODB_URI=mongodb://127.0.0.1:27017/nftguard

PORT=5000

# --- Blockchain -------------------------------------------------------------
# The ERC-721 marketplace contract, already deployed and public on the Sepolia
# testnet. Read it at:
#   https://sepolia.etherscan.io/address/0x8a4A907794816E6bE76993de230e134Ea95e61F4
CONTRACT_ADDRESS=0x8a4A907794816E6bE76993de230e134Ea95e61F4

# Leave SEPOLIA_RPC_URL unset to run in SIMULATED mode, which is the default:
# trading is recorded in the database, while ERC-165 compliance checks and
# mainnet token imports still query real blockchains.
#
# Set it to a Sepolia endpoint (free from alchemy.com or infura.io) to enable
# genuine on-chain minting, listing and buying through MetaMask.
# SEPOLIA_RPC_URL=

# Only needed to deploy a fresh copy of the contract. Testnet wallet only -
# never a wallet holding real funds.
# PRIVATE_KEY=

# Optional, for verifying contract source on Etherscan.
# ETHERSCAN_API_KEY=

# --- IPFS -------------------------------------------------------------------
# Gateway used to read ipfs:// token URIs when verifying imported mainnet
# tokens. The public gateway is used when this is unset.
# PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
# PINATA_JWT=

# --- Conversational assistant ------------------------------------------------
# Optional. Without a key the assistant falls back to a built-in scripted
# helper, so the chat widget still works. Free key: aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
